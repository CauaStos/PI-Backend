  "dependencies": {
    "@better-auth/mongo-adapter": "^1.7.2",
    "@types/cors": "^2.8.19",
    "better-auth": "1.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "mongodb": "^7.6.0",
    "mongoose": "^9.6.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.3.0",
