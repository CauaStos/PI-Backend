# Porta HTTP da API.
PORT=3000

# URL de conexao com o MongoDB local ou hospedado.
MONGO_URI=mongodb://localhost:27017/onstage
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:5173
BOOTSTRAP_ADMIN_NAME=Administrador
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-secure-password

# Issuer/audience esperados no JWT. Por padrao usam BETTER_AUTH_URL.
# JWT_ISSUER=http://localhost:3000
# JWT_AUDIENCE=http://localhost:3000

# Loga o link de redefinicao de senha no console. So funciona fora de
# producao (NODE_ENV != production) e nao existe envio por SMTP.
AUTH_PASSWORD_RESET_CONSOLE_URL=false

# `development` habilita o link de reset no console (deploy privado na tailnet).
# `production` desliga esse log; o Dockerfile usa production por padrao.
NODE_ENV=development

# Deploy na tailnet: aponte as duas URLs para a origem publica HTTPS do
# Tailscale Serve (ex.: https://pc.neko-bortle.ts.net). Elas precisam ser
# iguais entre si para cookies, CORS, redirect de reset e issuer/audience do JWT.
# BETTER_AUTH_URL=https://seu-host.tailnet.ts.net
# FRONTEND_ORIGIN=https://seu-host.tailnet.ts.net
